# ── Python cache ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Database files (generated at runtime — not committed) ───────
database/*.db
database/*.db-wal
database/*.db-shm
*.db
*.sqlite
*.sqlite3

# ── Large generated data files (regenerate with generator) ──────
sample_data/scalable_sample_*.json

# ── OS / editor artefacts ───────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp

# ── Secrets / credentials ───────────────────────────────────────
.env
*.pem
*.key
secrets.*

