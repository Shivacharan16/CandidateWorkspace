{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Run CDC Backend & Dashboard (FastAPI)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start_server.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "2. Run All Automated Tests (pytest)",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": ["backend/tests", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "3. Run Batch Ingestion (Starter Sample)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_pipeline.py",
      "console": "integratedTerminal"
    },
    {
      "name": "4. Run Reconciliation Audit Report",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_reconciliation.py",
      "console": "integratedTerminal"
    },
    {
      "name": "5. Run Performance Benchmark (10k Records)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_benchmark.py",
      "args": ["--count", "10000"],
      "console": "integratedTerminal"
    }
  ]
}
